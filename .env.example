# ==============================================================================
# ADITYA PLATFORM — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ----------------- BACKEND CONFIGURATION (server/.env) -----------------
# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/aditya_platform?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/aditya_platform

# JWT Authentication Secret & Session Expiry
JWT_SECRET=aditya_super_secret_production_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Anthropic Claude API Key (for 24/7 AI Learning Tutor)
# Obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Allowed Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# ----------------- FRONTEND CONFIGURATION (client/.env) ----------------
# Leave blank for local development proxy (/api), or specify backend production domain
VITE_API_URL=
