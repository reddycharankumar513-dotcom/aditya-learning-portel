# =================================================================
# LEARNOVA - AI Career Intelligence Platform
# Server Environment Configuration (.env.example)
# =================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or local MongoDB replica set)
MONGODB_URI=mongodb://localhost:27017/learnova_platform
# Example MongoDB Atlas Production URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@learnova-cluster.mongodb.net/learnova?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=learnova_production_jwt_secret_token_minimum_32_characters_random
JWT_EXPIRES_IN=7d

# AI Provider Configuration (LLM Orchestration)
# Get Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Get Anthropic API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Get OpenAI API key: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Razorpay Payment Gateway (Indian Rupee & International)
# Get keys: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_for_hmac_verification

# Client Origin (CORS Whitelist)
CLIENT_URL=http://localhost:5173

