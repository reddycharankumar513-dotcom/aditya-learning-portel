# ADITYA Server Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/aditya_platform
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/aditya_platform?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=aditya_super_secret_production_key_replace_in_prod_2026
JWT_EXPIRES_IN=7d

# Claude AI API (Anthropic)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173
