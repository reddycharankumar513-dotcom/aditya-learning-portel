# =================================================================
# LEARNOVA - AI Career Intelligence Platform
# Server Environment Configuration (.env.example)
# =================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or local MongoDB replica set)
MONGODB_URI=mongodb://localhost:27017/learnova_platform
# Example MongoDB Atlas Production URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@learnova-cluster.mongodb.net/learnova?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=learnova_production_jwt_secret_token_minimum_32_characters_random
JWT_EXPIRES_IN=7d

# =================================================================
# AI Orchestration & Multi-Provider Engine
# Supported: anthropic, openai, gemini, rule-engine (zero-downtime offline fallback)
# =================================================================
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-sonnet-20241022
AI_REQUEST_TIMEOUT=45000
AI_MAX_RETRIES=2
AI_MAX_TOKENS=4000
AI_RATE_LIMIT=60

# Provider API Credentials (Backend Only — Never exposed to frontend)
# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OpenAI GPT-4o: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
# Google Gemini: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Resume Upload & Storage Limits
RESUME_MAX_FILE_SIZE=10485760 # 10MB in bytes
RESUME_STORAGE_PROVIDER=local # local | s3

# Razorpay Payment Gateway (Indian Rupee & International)
# Get keys: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_for_hmac_verification

# AWS S3 Storage & Infrastructure (Optional Zero-Rupee Free Tier / Production)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=learnova-storage-prod

# Client Origin (CORS Whitelist)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://learnova.in,https://app.learnova.in,https://admin.learnova.in
