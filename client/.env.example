# Backend API Base URL (leave empty in development if using Vite proxy)
VITE_API_URL=http://localhost:5000

# Public Razorpay Key ID for client-side Checkout Modal
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key_id
